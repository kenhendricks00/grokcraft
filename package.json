{
  "name": "grokcraft",
  "version": "0.1.0",
  "description": "Mineflayer companion bot for Minecraft Java Edition, controlled one shell command at a time",
  "license": "MIT",
  "private": true,
  "bin": {
    "grokcraft": "bin/grokcraft"
  },
  "main": "src/cli.cjs",
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/grokcraft start",
    "daemon": "node src/daemon.cjs",
    "test": "node --test test/",
    "lint": "node scripts/lint.cjs"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-tool": "^1.2.0",
    "vec3": "^0.2.0"
  },
  "repository": "github:kenhendricks00/grokcraft"
}
